# Postgres bootstrap superuser — used only by docker-compose to init the
# container and run docker/postgres/init/01-roles.sh. Never used by the app.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tiny_threads

# Migration role — owns tenant-scoped tables, runs TypeORM migrations.
APP_OWNER_PASSWORD=change-me

# Application runtime role — non-owner, subject to RLS policies.
APP_RUNTIME_PASSWORD=change-me

# Migrations — connects as app_owner (table owner, runs DDL via the TypeORM CLI).
DATABASE_URL_MIGRATIONS=postgresql://app_owner:change-me@localhost:5432/tiny_threads

# App runtime — connects as app_runtime (subject to RLS policies).
DATABASE_URL=postgresql://app_runtime:change-me@localhost:5432/tiny_threads

JWT_SECRET=
OAUTH_STATE_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
