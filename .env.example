# All variables below are validated at boot by apps/api/src/config/env.validation.ts —
# a missing or empty required value fails the app immediately with a clear error
# listing everything wrong, rather than failing later at first use.

# Postgres bootstrap superuser — used only by docker-compose to init the
# container and run docker/postgres/init/01-roles.sh. Never used by the app.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tiny_threads

# Migration role — owns tenant-scoped tables, runs TypeORM migrations.
APP_OWNER_PASSWORD=change-me

# Application runtime role — non-owner, subject to RLS policies.
APP_RUNTIME_PASSWORD=change-me

# Migrations — connects as app_owner (table owner, runs DDL via the TypeORM CLI).
DATABASE_URL_MIGRATIONS=postgresql://app_owner:change-me@localhost:5432/tiny_threads

# App runtime — connects as app_runtime (subject to RLS policies).
DATABASE_URL=postgresql://app_runtime:change-me@localhost:5432/tiny_threads

# Signing secret for access tokens (TokenService) — shared by both the
# customer and merchant-admin populations, which are kept apart by the token's
# `aud` claim rather than by separate keys.
JWT_SECRET=

# HMAC secret for the signed OAuth `state` blob (OAuthStateService).
OAUTH_STATE_SECRET=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public origin of the PLATFORM domain (no trailing slash), e.g.
# https://api.tiny-threads.com — in dev, http://localhost:3000.
# Google allows only one registered redirect_uri, so it can't be a per-tenant
# subdomain: this builds the single centralized
# `<PLATFORM_BASE_URL>/auth/google/callback` that must match what's registered
# in Google Cloud Console. Required — GoogleOAuthController throws at boot if
# it's unset (both /google/initiate handlers read it too).
PLATFORM_BASE_URL=http://localhost:3000
