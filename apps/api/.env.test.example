# apps/api/.env.test.example — Environment Configuration for API Tests

NODE_ENV=test
PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tiny_threads_test
POSTGRES_PORT=5433

APP_OWNER_PASSWORD=change-me
APP_RUNTIME_PASSWORD=change-me

DATABASE_URL_MIGRATIONS=postgresql://app_owner:change-me@localhost:5433/tiny_threads_test
DATABASE_URL=postgresql://app_runtime:change-me@localhost:5433/tiny_threads_test

JWT_SECRET=test-secret
OAUTH_STATE_SECRET=test-secret
GOOGLE_OAUTH_CLIENT_ID=test-client-id
GOOGLE_OAUTH_CLIENT_SECRET=test-client-secret
PLATFORM_BASE_URL=http://localhost:3000
ADMIN_WEB_ORIGIN=http://localhost:3000
