{
  "name": "tiny-threads",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @tiny-threads/shared build",
    "dev:api": "pnpm --filter @tiny-threads/api start:dev",
    "dev:admin-web": "pnpm --filter @tiny-threads/admin-web dev",
    "db:generate": "pnpm --filter @tiny-threads/api db:generate",
    "db:migrate": "pnpm --filter @tiny-threads/api db:migrate",
    "db:revert": "pnpm --filter @tiny-threads/api db:revert",
    "db:verify-fresh": "pnpm --filter @tiny-threads/api db:verify-fresh",
    "create-tenant": "pnpm --filter @tiny-threads/api create-tenant",
    "create-owner-user": "pnpm --filter @tiny-threads/api create-owner-user",
    "test": "pnpm --filter @tiny-threads/api test",
    "test:e2e": "pnpm --filter @tiny-threads/api test:e2e",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "lint:check": "pnpm --filter @tiny-threads/api lint:check",
    "format": "prettier --write \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\""
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "typescript": "~5.7.3"
  }
}
