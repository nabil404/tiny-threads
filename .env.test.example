# Self-contained config for the SEPARATE test database instance (postgres-test
# in docker-compose.test.yml, port 5433, db tiny_threads_test) — never the
# same instance dev's .env points at, so running tests can never touch dev
# data.
#
# Copy to .env.test (gitignored) and fill in values. This file is the only
# source of truth for the test stack: docker-compose.test.yml is invoked with
# --env-file pointing at it (see apps/api/package.json's test:db:up script),
# so these vars both boot the postgres-test container's roles AND configure
# the app/tests that connect to it. Loaded by apps/api/test/setup-unit.ts and
# setup-e2e.ts instead of .env, and by data-source.ts when NODE_ENV=test.

NODE_ENV=test

# Postgres bootstrap superuser for the postgres-test container, and the
# superuser connection tests use to bypass RLS for seeding/cleanup (e.g.
# apps/api/src/db/__tests__/tenant-db.spec.ts).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tiny_threads_test
POSTGRES_PORT=5433

# Migration role — owns tenant-scoped tables, runs TypeORM migrations.
APP_OWNER_PASSWORD=change-me

# Application runtime role — non-owner, subject to RLS policies.
APP_RUNTIME_PASSWORD=change-me

# Migrations — connects as app_owner.
DATABASE_URL_MIGRATIONS=postgresql://app_owner:change-me@localhost:5433/tiny_threads_test

# App runtime — connects as app_runtime.
DATABASE_URL=postgresql://app_runtime:change-me@localhost:5433/tiny_threads_test

JWT_SECRET=test-secret
OAUTH_STATE_SECRET=test-secret
GOOGLE_OAUTH_CLIENT_ID=test-client-id
GOOGLE_OAUTH_CLIENT_SECRET=test-client-secret
PLATFORM_BASE_URL=http://localhost:3000
